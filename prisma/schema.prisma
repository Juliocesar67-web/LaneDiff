datasource db {
    provider = "postgresql"
}

// 1. Next.js / TypeScript Client
generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

// 2. Python Client
generator py_client {
    provider  = "prisma-client-py"
    interface = "asyncio" // Matches your Python asyncio pipeline
}

model MatchQueue {
    id        String   @id
    status    Status   @default(PENDING)
    fetchedAt DateTime @default(now()) @map("fetched_at")
}

enum Status {
    PENDING
    IN_PROGRESS
    COMPLETED
}
